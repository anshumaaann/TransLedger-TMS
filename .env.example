# Copy this file to .env, then replace the password before sharing the system.
POSTGRES_DB=transledger
POSTGRES_USER=transledger
POSTGRES_PASSWORD=replace-with-a-long-unique-password
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
INITIAL_ADMIN_EMAIL=owner@yourcompany.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
INITIAL_ADMIN_NAME=System Administrator
WEB_PORT=8080
DEBUG=false
